{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dlay",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "dlay-produccion",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "--",
        "--port",
        "3200"
      ],
      "port": 3200,
      "autoPort": false
    },
    {
      "name": "dlay-produccion-local",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "set -a; . ./.env.local; set +a; npx next start --port 3300"
      ],
      "port": 3300,
      "autoPort": false
    }
  ]
}