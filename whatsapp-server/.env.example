# Las mismas que usa el panel (Supabase → Project Settings → API).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Una palabra larga y al azar. La misma va en el panel (Vercel) y en las
# Edge Functions de Supabase. Generala con: openssl rand -hex 32
BAILEYS_SECRET=
# Sólo en hostings que se duermen sin tráfico y no dan su propia URL.
# En Render no hace falta: usa RENDER_EXTERNAL_URL solo.
KEEPALIVE_URL=
